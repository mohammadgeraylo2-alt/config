worker_processes 1;
pid ${NGINX_RUN_DIR}/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
    access_log off; server_tokens off; sendfile on; client_max_body_size 2m;
    client_body_temp_path ${NGINX_RUN_DIR}/body; proxy_temp_path ${NGINX_RUN_DIR}/proxy;
    fastcgi_temp_path ${NGINX_RUN_DIR}/fc; uwsgi_temp_path ${NGINX_RUN_DIR}/uw; scgi_temp_path ${NGINX_RUN_DIR}/sc;
    server {
        listen ${PORT};
        # مسیر مخفی اتصال (WebSocket) -> Xray
        location = ${WS_PATH} {
            proxy_pass http://127.0.0.1:10000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_read_timeout 3600s; proxy_send_timeout 3600s; proxy_buffering off;
        }
        # بقیه -> پنل
        location / {
            proxy_pass http://127.0.0.1:8000;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
